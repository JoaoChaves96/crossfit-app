{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(uuid)/)"
  ],
  "testEnvironmentOptions": {},
  "globals": {
    "ts-jest": {
      "tsconfig": "<rootDir>/../tsconfig.json"
    }
  },
  "globalSetup": "<rootDir>/helpers/e2e-global-setup.ts",
  "setupFiles": ["<rootDir>/helpers/jest-e2e.setup.ts"]
}
