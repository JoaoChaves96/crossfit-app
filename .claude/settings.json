{
  "mcpServers": {
    "project-docs": {
      "type": "stdio",
      "command": "node",
      "args": [
        "mcp/docs.mcp.json"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsc --noEmit *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/lowctx-notice.sh"
          }
        ]
      }
    ]
  }
}
